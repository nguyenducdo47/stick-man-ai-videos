generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  SCRIPTING
  STORYBOARD
  READY
}

enum AiGenerationKind {
  SCRIPT
  STORYBOARD
}

enum AiGenerationStatus {
  SUCCESS
  FAILED
}

enum ProjectRenderStatus {
  SUCCESS
  FAILED
}

model User {
  id          BigInt    @id @default(autoincrement())
  publicId    String    @unique @default(uuid()) @db.Uuid
  email       String?   @unique
  displayName String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]
}

model Project {
  id                BigInt        @id @default(autoincrement())
  publicId          String        @unique @default(uuid()) @db.Uuid
  userId            BigInt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  topic             String
  targetDurationSec Int?
  targetSceneCount  Int?
  languages         String[]
  visualStyle       String?
  scriptDraft       String?       @db.Text
  status            ProjectStatus @default(DRAFT)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  scenes            Scene[]
  aiGenerations     AiGeneration[]
  renders           ProjectRender[]

  @@index([userId])
  @@index([createdAt])
}

model ProjectRender {
  id           BigInt              @id @default(autoincrement())
  publicId     String              @unique @default(uuid()) @db.Uuid
  projectId    BigInt
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locale       String
  status       ProjectRenderStatus
  videoPath    String?             @db.Text
  errorMessage String?             @db.Text
  durationSec  Float?
  sceneCount   Int?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([projectId, locale])
  @@index([projectId])
}

model AiGeneration {
  id           BigInt             @id @default(autoincrement())
  publicId     String             @unique @default(uuid()) @db.Uuid
  projectId    BigInt
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind         AiGenerationKind
  status       AiGenerationStatus
  model        String
  errorMessage String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([projectId])
  @@index([createdAt])
}

model Scene {
  id              BigInt              @id @default(autoincrement())
  publicId        String              @unique @default(uuid()) @db.Uuid
  projectId       BigInt
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sortOrder       Int
  title           String?
  description     String?             @db.Text
  characterAction String?             @db.Text
  animationPreset String?
  cameraPreset    String?
  durationSec     Float?
  config          Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  localizations   SceneLocalization[]

  @@unique([projectId, sortOrder])
  @@index([projectId])
}

model SceneLocalization {
  id        BigInt   @id @default(autoincrement())
  publicId  String   @unique @default(uuid()) @db.Uuid
  sceneId   BigInt
  scene     Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  locale    String
  narration         String?   @db.Text
  subtitles         String?   @db.Text
  audioPath         String?   @db.Text
  audioGeneratedAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([sceneId, locale])
  @@index([sceneId])
}