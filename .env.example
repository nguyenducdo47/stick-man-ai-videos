# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_video_studio?schema=public"

# Redis (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# API
API_PORT=3001
API_HOST=127.0.0.1
# Optional — URL headless Remotion uses to fetch scene audio during render
# API_PUBLIC_URL=http://127.0.0.1:3001
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Ollama (local LLM)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen3:4b
OLLAMA_FALLBACK_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_MS=300000
OLLAMA_CONCURRENCY=1

# Local TTS service
TTS_SERVICE_URL=http://127.0.0.1:5001
TTS_CONCURRENCY=1
# KorvaTTS — đọc bởi services/local-tts khi khởi động uvicorn (cùng file .env này):
# KORVATTS_VOICE_VI=khanh_vy
# KORVATTS_TOTAL_STEPS=32
# KORVATTS_SPEED=1.05
# KORVATTS_ASSETS_DIR=
# Piper (optional fallback); set before uvicorn:
# PIPER_EXE=
# PIPER_MODEL_VI=
# TTS_BACKEND_VI=auto

# Storage (local filesystem)
# Repo root `data/` when API runs from apps/api (or set an absolute path)
STORAGE_ROOT=./data

# Video rendering (optional — API also uses Remotion's bundled ffmpeg if empty)
RENDER_CONCURRENCY=1
# Example Laragon: C:\laragon\bin\ffmpeg\ffmpeg-7.0.2-full_build\bin\ffmpeg.exe
FFMPEG_PATH=