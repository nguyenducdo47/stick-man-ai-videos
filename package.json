{
  "name": "ai-video-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI Video Studio monorepo",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @ai-video-studio/database db:generate",
    "db:deploy": "pnpm --filter @ai-video-studio/database db:deploy",
    "db:migrate": "pnpm --filter @ai-video-studio/database db:migrate",
    "db:push": "pnpm --filter @ai-video-studio/database db:push",
    "db:seed": "pnpm --filter @ai-video-studio/database db:seed"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}